<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules) equivalent of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
